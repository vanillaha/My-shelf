# 复制本文件为 .env，再把下面的值换成你自己的（.env 不要提交到 git）

# 业务库连接串
DATABASE_URL=postgresql://user:password@host/dbname

# 测试库连接串（npm test 时自动切到这个库）
TEST_DATABASE_URL=postgresql://user:password@host/test_dbname

# JWT 签名密钥：必须自己生成，绝不能用仓库里的示例值
# 生成命令：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=在这里粘贴你自己生成的随机字符串

# development / production
NODE_ENV=development
